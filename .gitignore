# del proyecto entregable.
TRASPASO.md
SESION.md
SESSION_LOG.md
CONVENCIONES.md

# ---- Añadidos 2026-09-30 ----
# MediaLibrary es datos de runtime del usuario (indice + archivos
# adjuntos). No forma parte del codigo del proyecto.
/MediaLibrary/

# scripts/ es siempre local: scripts one-shot de cada sesion de fix.
/scripts/

# Scripts one-shot con "_mixin" en el nombre que NO son modulos reales
# del proyecto. La excepcion !*_mixin.py del bloque anterior los
# capturaba por error y se colaban al repo.
/fix_*_mixin.py
/add_*_mixin.py
/apply_*_mixin.py
/probe_*_mixin.py

# ---- Añadidos 2026-10-02 (i18n_de_v1) ----
# Swap del editor Kate
.kate-swp
*.kate-swp

# Parches sueltos y scripts de integración i18n one-shot.
# rebuild_i18n.sh SÍ se sube (es la herramienta del proyecto).
*.patch
integrar_i18n*.sh
integrar_*.sh

# ---- Añadidos 2026-10-02 (packaging AUR) ----
# Artefactos de makepkg: no son codigo, se regeneran en cada build.
packaging/aur/pkg/
packaging/aur/src/
packaging/aur/*.pkg.tar.*
packaging/aur/virtual-machine/
packaging/appimage/dist/
