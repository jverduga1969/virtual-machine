post_install() {
    echo "==> Virtual.Machine instalado."
    echo "==> Asegurate de que tu usuario esta en el grupo 'kvm':"
    echo "    sudo usermod -aG kvm \$USER"
    echo "==> (Requiere cerrar sesion para aplicar el cambio de grupo)."
    echo "==> Para permisos USB sin contrasena, usa el boton"
    echo "    'Configurar permisos USB' en Configuracion Host."
    update-desktop-database -q 2>/dev/null || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}

post_upgrade() {
    post_install
}

post_remove() {
    update-desktop-database -q 2>/dev/null || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}
